# Copy to /home/seiya/.config/research-bots/arxiv.env and replace the values.
# Keep this file at mode 0600.  Values containing spaces must be quoted.
GEMINI_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Leave empty to use the built-in default model.
GEMINI_MODEL=
# Fine-grained PAT for refrain1539/arxiv-bot: repository metadata read + Issues read/write.
# This token is used only for Issue creation, closing and feedback collection.
GITHUB_TOKEN=
GITHUB_REPOSITORY=refrain1539/arxiv-bot
